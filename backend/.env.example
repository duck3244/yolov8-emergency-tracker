# 이메일 알림 (Gmail의 경우 앱 비밀번호 사용)
SENDER_EMAIL=
SENDER_PASSWORD=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# 외부 알림 채널 (선택)
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# 모델/디바이스 오버라이드 (선택)
YOLO_MODEL_PATH=yolov8s.pt
DEVICE=auto

# 웹 API
# - APP_TOKEN 설정 시 /api/*, /ws, /stream, /api/snapshot 에 Bearer/?token= 필요
# - 미설정 시 LAN 노출 방지를 위해 자동으로 127.0.0.1 바인딩만 허용됨
APP_TOKEN=
APP_HOST=127.0.0.1
APP_PORT=8000

# 카운트 영속성
# - 5분 주기로 backend/output/session_state.json 자동 저장
# - 시작 시 복원하려면 true
RESTORE_LAST_SESSION=false
